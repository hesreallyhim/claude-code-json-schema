{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hesreallyhim/claude-code-json-schema/main/schemas/marketplace.schema.json",
  "title": "Claude Code Marketplace Catalog (.claude-plugin/marketplace.json) - unofficial best-effort schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "owner",
    "plugins"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema self-reference URI.",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "description": "Marketplace identifier (kebab-case, no spaces).",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "description": "Brief marketplace description (may appear at root or in metadata)."
    },
    "version": {
      "type": "string",
      "description": "Marketplace version (may appear at root or in metadata)."
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the maintainer or team."
        },
        "email": {
          "type": "string",
          "description": "Contact email for the maintainer.",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Brief marketplace description."
        },
        "version": {
          "type": "string",
          "description": "Marketplace version."
        },
        "pluginRoot": {
          "type": "string",
          "description": "Base directory prepended to relative plugin source paths.",
          "allOf": [
            {
              "not": {
                "pattern": "^/"
              }
            },
            {
              "not": {
                "pattern": "\\.\\."
              }
            }
          ]
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pluginEntry"
      }
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "relativeOrRootedPath": {
      "type": "string",
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "\\.\\."
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        }
      ]
    },
    "githubSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "repo"
      ],
      "properties": {
        "source": {
          "const": "github"
        },
        "repo": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "ref": {
          "type": "string"
        },
        "sha": {
          "$ref": "#/$defs/sha40"
        }
      }
    },
    "urlSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "url"
      ],
      "properties": {
        "source": {
          "const": "url"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://.+\\.git$"
        },
        "ref": {
          "type": "string"
        },
        "sha": {
          "$ref": "#/$defs/sha40"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/relativeOrRootedPath"
        },
        {
          "$ref": "#/$defs/githubSource"
        },
        {
          "$ref": "#/$defs/urlSource"
        }
      ]
    },
    "authorObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "author": {
      "description": "Author information. Object form with name (required) and email (optional).",
      "$ref": "#/$defs/authorObject"
    },
    "repositoryObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "directory": {
          "type": "string"
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^\\./",
      "allOf": [
        {
          "not": {
            "pattern": "\\.\\."
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        }
      ]
    },
    "pathOrArray": {
      "oneOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      ]
    },
    "pathOrObject": {
      "oneOf": [
        {
          "$ref": "#/$defs/pathOrArray"
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "pluginSettings": {
      "type": "object",
      "description": "Plugin default settings applied when enabled.",
      "additionalProperties": true
    },
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "$ref": "#/$defs/repositoryObject"
            }
          ]
        },
        "license": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strict": {
          "type": "boolean",
          "default": true
        },
        "commands": {
          "$ref": "#/$defs/pathOrArray"
        },
        "agents": {
          "$ref": "#/$defs/pathOrArray"
        },
        "skills": {
          "$ref": "#/$defs/pathOrArray"
        },
        "hooks": {
          "$ref": "#/$defs/pathOrObject"
        },
        "mcpServers": {
          "$ref": "#/$defs/pathOrObject"
        },
        "lspServers": {
          "$ref": "#/$defs/pathOrObject"
        },
        "settings": {
          "$ref": "#/$defs/pluginSettings"
        }
      }
    }
  },
  "$comment": "Best-effort schema reconstruction based on official docs and Claude CLI interactions."
}
